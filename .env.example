# Copy to .env (never committed) and fill in. The frontend reads it through Vite; the backend reads the same names from its environment.

# Backend
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>
# Local runs only, never production: with DEBUG=true and DEBUG_USER_JWT set, only that token
# signs in, as one user named DEBUG_USER_NAME. The browser sends it once localStorage holds it
# under `rocksolid.debugUserJwt`.
DEBUG=false
DEBUG_USER_JWT=
DEBUG_USER_NAME=

# Firebase. The frontend puts every FIREBASE_* value into the browser, so these hold only
# the public web config from the Firebase console, never a secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
