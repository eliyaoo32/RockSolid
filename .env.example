# Copy to .env (never committed) and fill in. The frontend reads it through Vite; the backend reads the same names from its environment.

# Backend
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>
# Local runs only, never production: with DEBUG=true and DEBUG_USER_JWT set, only that token
# signs in, as one user named DEBUG_USER_NAME, in place of a Firebase ID token.
DEBUG=false
DEBUG_USER_JWT=
DEBUG_USER_NAME=
# With DEBUG=true and DEBUG_USER_JWT set, each agent's web chat, signed in as the debug user, on
# 127.0.0.1 from this port up, one port per agent.
DEBUG_CHAT_PORT=8100

# Ollama: Ollama Cloud by default, or a server such as http://localhost:11434/v1. A deployable
# whose agents use Ollama does not start without the API key.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# Firebase. The frontend puts every FIREBASE_* value into the browser, so these hold only
# the public web config from the Firebase console, never a secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
