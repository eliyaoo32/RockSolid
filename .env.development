# The settings `make dev` runs on, committed because none is a secret. Vite reads it for the
# frontend's dev server, and `make dev` passes it to the backend as environment variables.

# The Postgres in compose.yaml.
DATABASE_URL=postgresql+asyncpg://rocksolid:rocksolid@localhost:5432/rocksolid

# The dev Firebase project. The frontend puts every FIREBASE_* value into the browser, so these
# hold only the public web config from the Firebase console, never a secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
